{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AWS Collector Output",
  "description": "Security posture output from the epack AWS collector. The `collected_at_level` field indicates how much detail this artifact contains. Level-gated arrays emit `null` when not collected at the active level, `[]` when collected with no rows, and `[...]` when populated. See docs/levels.md for the artifact contract.",
  "type": "object",
  "required": ["schema_version", "collected_at", "collected_at_level", "accounts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 timestamp of collection"
    },
    "collected_at_level": {
      "type": "string",
      "enum": ["trust", "audit", "internal"],
      "description": "Collection level the artifact was produced at. See docs/levels.md."
    },
    "accounts": {
      "type": "array",
      "description": "Posture data for each collected account",
      "items": {
        "$ref": "#/definitions/AccountPosture"
      }
    },
    "diagnostics": {
      "type": ["object", "null"],
      "description": "Per-account errors and surface-level warnings encountered during collection. Absent when there were none.",
      "properties": {
        "account_errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "AccountPosture": {
      "type": "object",
      "required": [
        "account_id", "regions",
        "iam", "s3", "rds", "network", "account_security",
        "identity_center", "lambda", "ec2", "cloudwatch_logs", "kms", "secrets_manager", "ssm_parameters"
      ],
      "properties": {
        "account_id": { "type": "string", "pattern": "^[0-9]{12}$" },
        "account_alias": { "type": ["string", "null"] },
        "regions": { "type": "array", "items": { "type": "string" } },
        "iam": { "$ref": "#/definitions/IAMMetrics" },
        "s3": { "$ref": "#/definitions/S3Metrics" },
        "rds": { "$ref": "#/definitions/RDSMetrics" },
        "network": { "$ref": "#/definitions/NetworkMetrics" },
        "account_security": { "$ref": "#/definitions/AccountSecurity" },
        "identity_center": { "$ref": "#/definitions/IdentityCenterStatus" },
        "lambda": { "$ref": "#/definitions/LambdaMetrics" },
        "ec2": { "$ref": "#/definitions/EC2Metrics" },
        "cloudwatch_logs": { "$ref": "#/definitions/CloudWatchLogsMetrics" },
        "kms": { "$ref": "#/definitions/KMSMetrics" },
        "secrets_manager": { "$ref": "#/definitions/SecretsManagerMetrics" },
        "ssm_parameters": { "$ref": "#/definitions/SSMParametersMetrics" }
      }
    },

    "LevelGatedArray": {
      "description": "A level-gated inventory array. Null when not collected at the active level; an array (possibly empty) otherwise. See docs/levels.md.",
      "oneOf": [
        { "type": "null" },
        { "type": "array" }
      ]
    },

    "IAMMetrics": {
      "type": "object",
      "required": [
        "iam_users_present", "mfa_enabled", "hardware_mfa_enabled", "access_keys_rotated",
        "root_mfa_enabled", "root_access_keys_exist",
        "users", "roles", "credential_report"
      ],
      "properties": {
        "iam_users_present": { "type": "boolean" },
        "mfa_enabled": { "type": "integer", "minimum": 0, "maximum": 100 },
        "hardware_mfa_enabled": { "type": "integer", "minimum": 0, "maximum": 100 },
        "access_keys_rotated": { "type": "integer", "minimum": 0, "maximum": 100 },
        "root_mfa_enabled": { "type": "boolean", "description": "True when root MFA is active." },
        "root_credentials_present": { "type": "boolean" },
        "root_password_present": { "type": "boolean" },
        "root_access_keys_exist": { "type": "boolean" },
        "root_signing_certificates_present": { "type": "boolean" },
        "root_access_protected": { "type": "boolean", "description": "True when root MFA is active or no long-term root credentials are present." },
        "root_organizations_features_evaluated": { "type": "boolean" },
        "root_organization_id": { "type": "string", "pattern": "^o-[a-z0-9]{10,32}$" },
        "root_credentials_management_feature_enabled": { "type": "boolean", "description": "True when IAM ListOrganizationsFeatures reported the RootCredentialsManagement centralized root access feature." },
        "root_sessions_feature_enabled": { "type": "boolean", "description": "True when IAM ListOrganizationsFeatures reported the RootSessions centralized root access feature." },
        "root_organizations_features_error_code": { "type": "string", "description": "Present when the centralized root access feature read was not evaluated." },
        "users": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-user rows. Null at trust." },
        "roles": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-role rows. Null at trust." },
        "credential_report": {
          "description": "Internal: full IAM credential report with per-user activity. Null when not collected at internal.",
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["users"], "properties": { "users": { "type": "array" } } }
          ]
        }
      }
    },

    "S3Metrics": {
      "type": "object",
      "required": [
        "public_access_blocked", "default_encryption_enabled", "versioning_enabled",
        "logging_enabled", "account_public_access_block_enabled",
        "buckets"
      ],
      "properties": {
        "public_access_blocked": { "type": "integer", "minimum": 0, "maximum": 100 },
        "default_encryption_enabled": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Percentage of buckets whose default encryption was evaluated and enabled." },
        "default_encryption_evaluated_count": { "type": "integer", "minimum": 0 },
        "default_encryption_inferred_count": { "type": "integer", "minimum": 0, "description": "Evaluated buckets counted as encrypted from documented AWS SSE-S3 baseline behavior rather than a readable encryption rule." },
        "default_encryption_unknown_count": { "type": "integer", "minimum": 0 },
        "versioning_enabled": { "type": "integer", "minimum": 0, "maximum": 100 },
        "logging_enabled": { "type": "integer", "minimum": 0, "maximum": 100 },
        "account_public_access_block_enabled": { "type": "boolean" },
        "buckets": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-bucket rows. Per-bucket policy/acl/lifecycle attached at internal." }
      }
    },

    "RDSMetrics": {
      "type": "object",
      "required": ["instances", "clusters"],
      "properties": {
        "encrypted_at_rest": { "type": "integer", "minimum": 0, "maximum": 100 },
        "publicly_accessible": { "type": "integer", "minimum": 0, "maximum": 100 },
        "deletion_protection": { "type": "integer", "minimum": 0, "maximum": 100 },
        "backup_retention_adequate": { "type": "integer", "minimum": 0, "maximum": 100 },
        "backup_retention_min": { "type": "integer", "minimum": 0 },
        "multi_az_enabled": { "type": "integer", "minimum": 0, "maximum": 100 },
        "instances": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-instance rows; internal adds latest_restorable_time." },
        "clusters": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-cluster rows; internal adds latest_restorable_time." }
      }
    },

    "NetworkMetrics": {
      "type": "object",
      "required": ["vpcs", "security_groups"],
      "properties": {
        "open_to_world_ssh": { "type": "integer", "minimum": 0, "maximum": 100 },
        "open_to_world_rdp": { "type": "integer", "minimum": 0, "maximum": 100 },
        "vpcs": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-VPC rows; internal adds flow_logs_enabled when evaluated, plus flow_logs_evaluated and flow_logs_error_code provenance." },
        "security_groups": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-SG rows; internal adds ingress_rules." }
      }
    },

    "AccountSecurity": {
      "type": "object",
      "required": ["cloudtrail", "config", "guardduty", "security_hub", "inspector"],
      "properties": {
        "cloudtrail": {
          "type": "object",
          "required": ["enabled", "multi_region_enabled", "trails"],
          "properties": {
            "enabled": { "type": "boolean" },
            "multi_region_enabled": { "type": "boolean" },
            "organization_trail_enabled": { "type": "boolean" },
            "trail_status_evaluated_count": { "type": "integer", "minimum": 0 },
            "trail_status_inferred_count": { "type": "integer", "minimum": 0, "description": "Trail statuses inferred from organization shadow-trail presence when the member account could not read GetTrailStatus." },
            "trail_status_unknown_count": { "type": "integer", "minimum": 0 },
            "trails": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-trail rows, including organization-trail and trail-status provenance; internal adds kms_key_arn and cloudwatch_logs_arn." }
          }
        },
        "config": {
          "type": "object",
          "required": ["enabled", "recorder_running", "recorders", "rules", "rules_truncated", "rules_dropped_count"],
          "properties": {
            "enabled": { "type": "boolean" },
            "recorder_running": { "type": "boolean" },
            "recorders": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-recorder rows." },
            "rules": { "$ref": "#/definitions/LevelGatedArray", "description": "Internal: per-rule compliance state. Capped at 1000 per region." },
            "rules_truncated": { "type": "boolean" },
            "rules_dropped_count": { "type": "integer", "minimum": 0 }
          }
        },
        "guardduty": {
          "type": "object",
          "required": ["enabled", "unremediated_findings_over_48h", "detectors", "findings", "findings_truncated", "findings_dropped_count"],
          "properties": {
            "enabled": { "type": "boolean" },
            "unremediated_findings_over_48h": { "type": "integer", "minimum": 0 },
            "detectors": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-region detector rows." },
            "findings": { "$ref": "#/definitions/LevelGatedArray", "description": "Internal: unarchived high-or-critical finding rows. Capped at 5000 per detector." },
            "findings_truncated": { "type": "boolean" },
            "findings_dropped_count": { "type": "integer", "minimum": 0 }
          }
        },
        "security_hub": {
          "type": "object",
          "required": ["enabled", "standards_arns", "product_subscriptions"],
          "properties": {
            "enabled": { "type": "boolean" },
            "auto_enable_controls": { "type": "boolean" },
            "integration_count": { "type": "integer", "minimum": 0 },
            "standards_arns": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: enabled standards ARNs." },
            "product_subscriptions": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: integration product ARNs." },
            "cis_aws_foundations_benchmark_level_1": { "$ref": "#/definitions/CISComplianceByLevel" },
            "cis_aws_foundations_benchmark_level_2": { "$ref": "#/definitions/CISComplianceByLevel" },
            "cis_aws_foundations_benchmark_unknown_level": { "$ref": "#/definitions/CISComplianceByLevel" }
          }
        },
        "inspector": {
          "type": "object",
          "required": ["enabled", "unpatched_server_percent"],
          "properties": {
            "enabled": { "type": "boolean" },
            "unpatched_server_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "total_findings": { "type": "integer", "minimum": 0 },
            "patched_findings": { "type": "integer", "minimum": 0 },
            "unpatched_findings": { "type": "integer", "minimum": 0 },
            "total_affected_resources": { "type": "integer", "minimum": 0 },
            "unpatched_resources": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "CISComplianceByLevel": {
      "type": "object",
      "required": ["enabled", "compliance_percent", "compliance_state"],
      "properties": {
        "enabled": { "type": "boolean" },
        "compliance_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "compliance_state": { "type": "string", "enum": ["PASSED", "WARNING", "FAILED", "NOT_AVAILABLE", "UNKNOWN", ""] },
        "passed_controls": { "type": "integer", "minimum": 0 },
        "failed_controls": { "type": "integer", "minimum": 0 },
        "warning_controls": { "type": "integer", "minimum": 0 },
        "not_available_controls": { "type": "integer", "minimum": 0 }
      }
    },

    "IdentityCenterStatus": {
      "type": "object",
      "description": "AWS IAM Identity Center (formerly AWS SSO) posture.",
      "required": ["enabled", "permission_sets", "users", "groups"],
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether an IdC instance exists in the primary region." },
        "instance_arn": { "type": "string" },
        "instance_region": { "type": "string" },
        "identity_store_id": { "type": "string" },
        "user_count": { "type": "integer", "minimum": 0 },
        "group_count": { "type": "integer", "minimum": 0 },
        "permission_set_count": { "type": "integer", "minimum": 0 },
        "permission_sets": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-permission-set rows; internal adds managed_policy_arns and has_inline_policy." },
        "users": { "$ref": "#/definitions/LevelGatedArray", "description": "Internal: per-user rows from the identity store." },
        "groups": { "$ref": "#/definitions/LevelGatedArray", "description": "Internal: per-group rows with member counts." }
      }
    },

    "LambdaMetrics": {
      "type": "object",
      "required": ["function_count", "deprecated_runtime_count", "functions", "functions_truncated", "functions_dropped_count"],
      "properties": {
        "function_count": { "type": "integer", "minimum": 0 },
        "deprecated_runtime_count": { "type": "integer", "minimum": 0, "description": "Functions running on AWS-deprecated runtimes." },
        "public_function_url_count": { "type": "integer", "minimum": 0, "description": "Audit enrichment: functions with a publicly-invokable Function URL (auth_type=NONE)." },
        "functions": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-function rows; internal adds arn / role_arn / kms_key_arn / layer_arns / env_var_names (KEYS ONLY)." },
        "functions_truncated": { "type": "boolean" },
        "functions_dropped_count": { "type": "integer", "minimum": 0 }
      }
    },

    "EC2Metrics": {
      "type": "object",
      "required": [
        "instance_count", "imdsv2_required_count", "public_ip_count",
        "default_vpc_count", "instances_with_unencrypted_volume_count",
        "instances", "instances_truncated", "instances_dropped_count"
      ],
      "properties": {
        "instance_count": { "type": "integer", "minimum": 0, "description": "Running instances only." },
        "imdsv2_required_count": { "type": "integer", "minimum": 0 },
        "public_ip_count": { "type": "integer", "minimum": 0 },
        "default_vpc_count": { "type": "integer", "minimum": 0 },
        "instances_with_unencrypted_volume_count": { "type": "integer", "minimum": 0 },
        "instances": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-instance rows; internal adds iam_instance_profile_arn / key_name / tags / attached_volume_ids." },
        "instances_truncated": { "type": "boolean" },
        "instances_dropped_count": { "type": "integer", "minimum": 0 }
      }
    },

    "CloudWatchLogsMetrics": {
      "type": "object",
      "required": [
        "log_group_count", "log_groups_without_retention_count", "log_groups_without_customer_kms_count",
        "log_groups", "log_groups_truncated", "log_groups_dropped_count"
      ],
      "properties": {
        "log_group_count": { "type": "integer", "minimum": 0 },
        "log_groups_without_retention_count": { "type": "integer", "minimum": 0 },
        "log_groups_without_customer_kms_count": { "type": "integer", "minimum": 0 },
        "log_groups": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-log-group rows; internal adds arn and kms_key_arn." },
        "log_groups_truncated": { "type": "boolean" },
        "log_groups_dropped_count": { "type": "integer", "minimum": 0 }
      }
    },

    "KMSMetrics": {
      "type": "object",
      "description": "KMS posture scoped to CUSTOMER-managed keys only.",
      "required": [
        "customer_managed_key_count", "cmks_with_rotation_disabled_count", "cmks_pending_deletion_count",
        "keys", "keys_truncated", "keys_dropped_count"
      ],
      "properties": {
        "customer_managed_key_count": { "type": "integer", "minimum": 0 },
        "cmks_with_rotation_disabled_count": { "type": "integer", "minimum": 0, "description": "Symmetric CMKs only; asymmetric / external-origin keys don't support rotation." },
        "cmks_pending_deletion_count": { "type": "integer", "minimum": 0 },
        "keys": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-key rows; internal adds description." },
        "keys_truncated": { "type": "boolean" },
        "keys_dropped_count": { "type": "integer", "minimum": 0 }
      }
    },

    "SecretsManagerMetrics": {
      "type": "object",
      "description": "Secrets Manager metadata only. Secret VALUES are never collected.",
      "required": [
        "secret_count", "secrets_without_rotation_count", "secrets_without_customer_kms_count", "secrets_pending_deletion_count",
        "secrets", "secrets_truncated", "secrets_dropped_count"
      ],
      "properties": {
        "secret_count": { "type": "integer", "minimum": 0 },
        "secrets_without_rotation_count": { "type": "integer", "minimum": 0 },
        "secrets_without_customer_kms_count": { "type": "integer", "minimum": 0 },
        "secrets_pending_deletion_count": { "type": "integer", "minimum": 0 },
        "secrets": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-secret rows; internal adds description / kms_key_arn / rotation_lambda_arn / tags." },
        "secrets_truncated": { "type": "boolean" },
        "secrets_dropped_count": { "type": "integer", "minimum": 0 }
      }
    },

    "SSMParametersMetrics": {
      "type": "object",
      "description": "SSM Parameter Store metadata only. Parameter VALUES are never collected.",
      "required": [
        "parameter_count", "secure_string_count", "secure_strings_without_customer_kms_count",
        "parameters", "parameters_truncated", "parameters_dropped_count"
      ],
      "properties": {
        "parameter_count": { "type": "integer", "minimum": 0 },
        "secure_string_count": { "type": "integer", "minimum": 0 },
        "secure_strings_without_customer_kms_count": { "type": "integer", "minimum": 0 },
        "parameters": { "$ref": "#/definitions/LevelGatedArray", "description": "Audit: per-parameter rows; internal adds description and kms_key_arn." },
        "parameters_truncated": { "type": "boolean" },
        "parameters_dropped_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
